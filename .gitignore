# 编译与打包的中间产物（由 build.ps1 / pack-portable.ps1 生成，不入库）
.pkg/
backup_*/
_*_backup*/*

# 根目录下的冒烟临时产物（--smoke 自动生成）
/ui-*.png
/ui-results.txt
/smoke.log

# 本地构建缓存
*.suo
*.user
*.userosscache
*.sln.docstates
*.cache
/build/
/obj/
/bin/
*.pdb
*.ilk
*.tmp
*.bak
*.orig
*.log.bak

# 编辑器 / 系统
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini

# 熔断备份目录（本地回滚用）
_backup_*/


# SFX 打包用的 7-Zip 二进制（本地缓存，可由 7-Zip 官网重新下载）
.tools/

# 冒烟日志
docs/evidence/smoke.log


# 便携版/探针解压残留（--keep 或调试时生成）
/LogSentry_unpacked/
dist/LogSentry_unpacked/
/LogSentry/
/.probe/

# 交付目录里的 .NET 安装包（随完整 zip 一起发，体积大，不入库）
# .NET Framework 4.8 offline installer (lives in dist/, shipped inside the full zip, not tracked)
/NDP48-*.exe
dist/NDP48-*.exe

# 打包脚本生成的测试桩（build.ps1 每次重建）
/dist/_selftest.exe
/dist/_smoke.exe

dist/config/
